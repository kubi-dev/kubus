        {"kto": "A", "znaki": "我来自北京。你呢？", "pinyin": "Wǒ láizì Běijīng. Nǐ ne?", "wymowa": "ło laj-dzy pej-dzing. ni na", "polski": "Jestem z Pekinu. A ty?"},
        {"kto": "B", "znaki": "我来自波兰。", "pinyin": "Wǒ láizì Bōlán.", "wymowa": "ło laj-dzy po-lan", "polski": "Jestem z Polski."},
        {"kto": "B", "znaki": "你很美丽。", "pinyin": "Nǐ hěn měilì.", "wymowa": "ni chyn mej-li", "polski": "Jesteś bardzo piękna."},
        {"kto": "A", "znaki": "谢谢！你很可爱。", "pinyin": "Xièxie! Nǐ hěn kě'ài.", "wymowa": "sie-sie! ni chyn khy-aj", "polski": "Dziękuję! Jesteś słodki."},
